{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run JavaFX (F5キーで実行)",

            // ▼ "type" を "java" に変更
            "type": "java",

            // ▼ "request" を "attach" に変更
            "request": "attach",

            // ▼ "attach" に必要なダミーの情報 (このままコピーでOK)
            "hostName": "localhost",
            "port": 5005, // （このポートは使いません）

            // ▼ これが本体。JavaFXアプリを起動するタスク
            "preLaunchTask": "RunJavaFX"
        }
    ]
}